{
  "name": "second-cerveau",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:preview": "vite build --mode single",
    "preview": "vite preview --host",
    "test": "vitest run",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "@fontsource/inter": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "chart.js": "^4.6.1",
    "dompurify": "^3.4.18",
    "fflate": "^0.8.3",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "autoprefixer": "^10.6.2",
    "fake-indexeddb": "^6.2.8",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
